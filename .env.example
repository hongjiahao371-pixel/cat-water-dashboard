# ── 相机取流地址（必填）───────────────────────────────────────────
# 直连相机 RTSP（家用相机通用）:
#   CAMERA_SOURCE_URL=rtsp://user:pass@camera-ip:554/stream1
# 或经 EasyNVR 的 HTTP-FLV 流（需要另行部署 EasyNVR）:
CAMERA_SOURCE_URL=rtsp://user:pass@camera-ip:554/stream1

# ── EasyNVR 增强（可选）──────────────────────────────────────────
# 不使用 EasyNVR 时保持为空: 高清播放/录像取证/每日巡检取证将优雅停用,
# 核心检测、事件、通知、归档不受影响。
EASYNVR_BASE_URL=
EASYNVR_USERNAME=
EASYNVR_PASSWORD=
EASYNVR_CHANNEL_ID=
EASYNVR_CHANNEL_ID_HD=
EASYNVR_CHANNEL_ID_SMOOTH=
NIGHT_HIRES_RTSP_URL=

# ── 相机时钟漂移监控（可选）───────────────────────────────────────
# 发现相机: python3 scripts/discover_camera.py
CAMERA_IP=
CAMERA_ONVIF_PORT=80
CAMERA_USER=
CAMERA_PASS=

# ── 安全 ────────────────────────────────────────────────────────
CAT_WATER_API_TOKEN=replace-with-a-long-random-token
